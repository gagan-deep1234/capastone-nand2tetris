// Part A - Memory.hdl
// Nand to Tetris I (ETCCNT301) Capstone Project
// Implements the complete Hack data memory address space:
//   0x0000 - 0x3FFF (0..16383)     : RAM16K (16K words)
//   0x4000 - 0x5FFF (16384..24575) : Screen (8K words, 512x256 B&W)
//   0x6000          (24576)        : Keyboard (1 word, read-only)

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Decode top two bits address[13..14]:
    //   00, 01 -> RAM16K
    //   10     -> Screen
    //   11     -> Keyboard
    DMux4Way(in=load, sel=address[13..14], a=loadRamA, b=loadRamB, c=loadScreen, d=loadKbd);
    Or(a=loadRamA, b=loadRamB, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
