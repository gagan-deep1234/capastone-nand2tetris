// Part A - CPU.hdl
// Nand to Tetris I (ETCCNT301) Capstone Project
// Implements the 16-bit Hack CPU (fetch-decode-execute cycle).

CHIP CPU {
    IN  inM[16],         // M value input (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to restart the current program (1) or continue (0)

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
    // Instruction type: instruction[15] == 0 -> A-instruction, 1 -> C-instruction
    Not(in=instruction[15], out=isAInst);

    // A-register input: instruction for A-inst, ALU output for C-inst
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=inA);

    // Load A if A-instruction OR (C-instruction and dest d1 = instruction[5] is set)
    Or(a=isAInst, b=instruction[5], out=loadA);
    ARegister(in=inA, load=loadA, out=outA, out[0..14]=addressM);

    // Select between A and M for ALU y-input using 'a' bit (instruction[12])
    Mux16(a=outA, b=inM, sel=instruction[12], out=aluY);

    // Load D if C-instruction and dest d2 = instruction[4] is set
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=outD);

    // Arithmetic Logic Unit (comp bits c1..c6 = instruction[11..6])
    ALU(
        x=outD,
        y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // Write to M if C-instruction and dest d3 = instruction[3] is set
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Jump condition evaluation (j1=instruction[2], j2=instruction[1], j3=instruction[0])
    Or(a=zr, b=ng, out=lteZero);
    Not(in=lteZero, out=pos);        // ALU output > 0

    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=pos, out=jgt);

    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCond);

    // Jump only on C-instructions
    And(a=instruction[15], b=jumpCond, out=loadPC);
    Not(in=loadPC, out=incPC);

    PC(in=outA, load=loadPC, inc=incPC, reset=reset, out[0..14]=pc);
}
