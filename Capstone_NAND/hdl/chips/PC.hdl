// Supporting Lab Chip - PC.hdl
// 16-bit Program Counter with reset, load, and inc control bits (Project 3)

CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
    Inc16(in=regOut, out=incOut);
    Mux16(a=regOut, b=incOut, sel=inc, out=afterInc);
    Mux16(a=afterInc, b=in, sel=load, out=afterLoad);
    Mux16(a=afterLoad, b=false, sel=reset, out=nextVal);
    Register(in=nextVal, load=true, out=regOut, out=out);
}
